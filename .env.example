# Copy this file to .env and adjust the values for your machine.
#
# Only EXPO_PUBLIC_* variables reach the app, and they are bundled into it:
# anyone with the app can read them. Never put a secret here. Secrets (AI keys,
# SMTP credentials) live only in Supabase.
#
# Every variable here is read and validated in src/lib/env.ts.

# Which build this is. Allowed: development | production. Default: development.
EXPO_PUBLIC_APP_ENV=development
